{
  "name": "ufaelgestor-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional estático da Ufaelgestor (GitHub Pages).",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "arch": "depcruise src tests --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "test:e2e": "playwright test",
    "serve": "http-server . -p 4173 -s",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.48.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@vitest/coverage-v8": "^2.1.3",
    "dependency-cruiser": "^16.4.2",
    "http-server": "^14.1.1",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "knip": "^5.33.3",
    "vitest": "^2.1.3"
  }
}
